# Copy to `.env` and adjust for your environment.
# Source of truth for tunable keys: `src/config/` and docs/architecture/backend/backend-architecture.md §11.
# Locked V1 domain constants (not env): `src/database/models/conventions.ts` — listed at bottom.

# ---- Application ----
# development | test | production (default: development)
NODE_ENV=development
# HTTP listen port (default: 5010 — matches frontend VITE_API_BASE_URL)
PORT=5010
# debug in non-production; info in production (default)
LOG_LEVEL=debug
# Comma-separated origins; required in production (dev default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# Required when the database integration connects (startup).
MONGODB_URI=

# ---- Vercel Blob ----
# Required for file upload/download: read-write token OR (store id + OIDC token).
BLOB_READ_WRITE_TOKEN=
# public | private (default: private)
BLOB_ACCESS=private
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# Presigned URL TTLs in seconds (defaults: upload 300, download 60)
BLOB_UPLOAD_URL_TTL_SECONDS=300
BLOB_DOWNLOAD_URL_TTL_SECONDS=60
# In-process PENDING file cleanup cron (defaults: enabled, interval 3600000 ms = 1 hour)
BLOB_CLEANUP_ENABLED=true
BLOB_CLEANUP_INTERVAL_MS=3600000

# ---- Razorpay ----
# Required for paid purchases and webhook verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Auth / JWT ----
# Required for auth operations; must be at least 32 characters.
JWT_SECRET=
# Defaults: issuer xplooreze, audience xplooreze-api
JWT_ISSUER=xplooreze
JWT_AUDIENCE=xplooreze-api
# TTL format: 15m, 7d, 3600s, etc. (defaults: access 15m, refresh 7d, reset 30m)
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL=30m
# Required when sending password-reset emails (e.g. http://localhost:5173/reset-password)
PASSWORD_RESET_URL_BASE=
# Refresh cookie (defaults: name refresh_token, path /auth, SameSite lax, Secure false except production)
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SAMESITE=lax
# Override Secure flag (production defaults to true if unset)
REFRESH_COOKIE_SECURE=

# ---- SMTP (Nodemailer) ----
# Required when email delivery runs (password reset, notifications).
SMTP_HOST=
# Default port 587; SMTP_SECURE default false
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ---- Background jobs ----
# Stale PENDING purchase cleanup cron (defaults: enabled, interval 3600000 ms = 1 hour)
PURCHASE_CLEANUP_ENABLED=true
PURCHASE_CLEANUP_INTERVAL_MS=3600000

# ---- Admin bootstrap (npm run seed:admin) ----
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=
ADMIN_BOOTSTRAP_LAST_NAME=

# ---- Locked V1 domain (NOT environment variables) ----
# These are code constants in src/database/models/conventions.ts — do not add to .env without an architecture change.
# V1_MAX_ATTEMPTS=3
# PAID_ENTITLEMENT_VALIDITY_DAYS=60
# PDF_SUBMISSION_MAX_SIZE_BYTES=20971520 (20 MB)
# DEFAULT_MAX_SCORE=100
# EXAM_SUBMISSION_GRACE_SECONDS=120 (MCQ/EDITOR final-submit grace after examEndsAt)
# PDF_UPLOAD_GRACE_SECONDS=300 (PDF upload window after examEndsAt)
# PENDING_PURCHASE_REUSE_WINDOW_MS=1800000 (30 minutes)
# STALE_PENDING_PURCHASE_MS=604800000 (7 days)
